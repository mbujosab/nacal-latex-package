 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+%% --- Negrita matemática guardada en cajas
+%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+\newif\ifnacal@bs@cajas \nacal@bs@cajastrue
+\newcount\nacal@bs@n
+\newcommand\nacal@bs[1]{\nacal@bs@{b}{#1}{#1}}
+\newcommand\nacal@bs@min[2]{\nacal@bs@{m}{#2}{\nacal@min{#1}{#2}}}
+\newcommand\nacal@bs@may[2]{\nacal@bs@{M}{#2}{\mathsf{\nacal@may{#1}{#2}}}}
+%% Si el cuerpo ha cambiado dentro de la formula (\large en modo
+%% matematico), \boldsymbol recarga las fuentes matematicas y eso altera el
+%% resto de la formula: ahi se llama a \boldsymbol como siempre.
+%% Tampoco se usan las cajas en las composiciones de prueba de los acentos
+%% de amsmath (\ddot{\Mat{x}}), que desactivan los alfabetos matematicos:
+%% se reconocen porque \select@group o \use@mathgroup estan cambiados.
+\def\nacal@bs@#1#2#3{%
+  \ifnum0\ifx\glb@currsize\f@size\else1\fi
+         \ifx\select@group\nacal@select@group\else1\fi
+         \ifx\use@mathgroup\nacal@use@mathgroup\else1\fi=\z@
+    \ifcsname nacal@bs@#1@\math@version @\f@size @\detokenize{#2}\endcsname\else
+      \nacal@bs@nueva{#1}{#2}{#3}%
+    \fi
+    \csname nacal@bs@#1@\math@version @\f@size @\detokenize{#2}\endcsname
+  \else
+    \boldsymbol{#3}%
+  \fi}
+\ExplSyntaxOn
+\protected\def\nacal@bs@nueva#1#2#3{
+  \group_begin:
+  \bool_set_false:N \l_tmpa_bool
+  \ifnacal@bs@cajas
+    \int_compare:nNnT \nacal@bs@n < { 1000 }
+      {
+        \regex_match:nnT { \A (?: \cL[A-Za-z] | \cO[0-9] | \cC. )* \Z } {#2}
+          {
+            \bool_set_true:N \l_tmpa_bool
+            \tl_map_inline:nn {#2}
+              { \token_if_cs:NT ##1
+                  { \token_if_mathchardef:NF ##1 { \bool_set_false:N \l_tmpa_bool } } }
+          }
+      }
+  \fi
+  \edef\nacal@tmpa{\exp_not:c { nacal@bs@#1@\math@version @\f@size @\detokenize{#2} } }
+  \bool_if:NTF \l_tmpa_bool
+    { \nacal@bs@crea {#3} }
+    { \exp_after:wN \xdef \nacal@tmpa { \exp_not:n { \boldsymbol {#3} } } }
+  \group_end:
+}
+\ExplSyntaxOff
+%% Las cuatro cajas (una por estilo) se componen igual que en \boldsymbol
+%% de amsbsy, una sola vez; despues se copian.
+\def\nacal@bs@crea#1{%
+  \global\advance\nacal@bs@n\@ne
+  \expandafter\newbox\csname nacal@bx@\the\nacal@bs@n @D\endcsname
+  \expandafter\newbox\csname nacal@bx@\the\nacal@bs@n @T\endcsname
+  \expandafter\newbox\csname nacal@bx@\the\nacal@bs@n @S\endcsname
+  \expandafter\newbox\csname nacal@bx@\the\nacal@bs@n @s\endcsname
+  \begingroup
+    \let\@nomath\@gobble \mathversion{bold}%
+    %% Como en \boldsymbol: primero la composicion de prueba de \binrel@
+    %% (ya en negrita), que ademas hace que LaTeX asigne los alfabetos
+    %% antes de componer las cajas que se guardan.
+    \binrel@{#1}%
+    \global\setbox\csname nacal@bx@\the\nacal@bs@n @D\endcsname\hbox{$\m@th\displaystyle#1$}%
+    \global\setbox\csname nacal@bx@\the\nacal@bs@n @T\endcsname\hbox{$\m@th\textstyle#1$}%
+    \global\setbox\csname nacal@bx@\the\nacal@bs@n @S\endcsname\hbox{$\m@th\scriptstyle#1$}%
+    \global\setbox\csname nacal@bx@\the\nacal@bs@n @s\endcsname\hbox{$\m@th\scriptscriptstyle#1$}%
+    \expandafter\xdef\nacal@tmpa{%
+      \ifx\binrel@@\mathbin \noexpand\mathbin \else
+        \ifx\binrel@@\mathrel \noexpand\mathrel \else \relax \fi\fi
+      {\noexpand\mathchoice
+        {\copy\csname nacal@bx@\the\nacal@bs@n @D\endcsname}%
+        {\copy\csname nacal@bx@\the\nacal@bs@n @T\endcsname}%
+        {\copy\csname nacal@bx@\the\nacal@bs@n @S\endcsname}%
+        {\copy\csname nacal@bx@\the\nacal@bs@n @s\endcsname}}}%
+  \endgroup}
+%% Solo si \boldsymbol es el de amsbsy; con avisacaja, tampoco (cada uso
+%% debe pasar por el aviso).
+\AtBeginDocument{%
+  \begingroup
+    \long\def\nacal@tmpb#1{\begingroup \let\@nomath\@gobble \mathversion{bold}%
+      \math@atom{#1}{\mathchoice
+        {\hbox{$\m@th\displaystyle#1$}}{\hbox{$\m@th\textstyle#1$}}%
+        {\hbox{$\m@th\scriptstyle#1$}}{\hbox{$\m@th\scriptscriptstyle#1$}}}\endgroup}%
+    \expandafter\ifx\csname boldsymbol \endcsname\nacal@tmpb\else
+      \global\nacal@bs@cajasfalse \fi
+  \endgroup
+  \ifnacal@avisacaja \global\nacal@bs@cajasfalse \fi
+  \global\let\nacal@select@group\select@group
+  \global\let\nacal@use@mathgroup\use@mathgroup}
